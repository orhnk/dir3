<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="28dp"
    android:paddingTop="64dp"
    android:paddingRight="28dp"
    android:paddingBottom="40dp">

    <TextView
        android:id="@+id/alarmTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:textColor="#f4f8fb"
        android:textSize="72sp"
        android:text="03:00" />

    <TextView
        android:id="@+id/alarmLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="#7fd1c1"
        android:textSize="26sp"
        android:textStyle="bold"
        android:text="Fajr" />

    <TextView
        android:id="@+id/alarmEvent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#93a1b0"
        android:textSize="15sp"
        android:text="Plan eventi" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/alarmHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#93a1b0"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/challengeBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnSnooze"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="#1f262e"
            android:text="5 dakika ertele"
            android:textAllCaps="false"
            android:textColor="#e8eef4"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#7fd1c1"
            android:text="Kapat"
            android:textAllCaps="false"
            android:textColor="#07221e"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
